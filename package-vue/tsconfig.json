{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": { "@core/*": ["../package/src/*"] }
  },
  "include": ["src", "playground", "../package/src/globals.d.ts", "../package/src/scss.d.ts"],
  "exclude": ["node_modules", "dist"]
}
