{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": {
      "agentation-element/mount": ["../package-element/src/mount.ts"],
      "@agentation/core/*": ["../package-core/src/*"]
    }
  },
  "include": ["src", "test", "playground", "src/globals.d.ts", "src/scss.d.ts"],
  "exclude": ["node_modules", "dist"]
}
