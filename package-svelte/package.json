{
  "name": "agentation-svelte",
  "version": "0.0.1",
  "description": "Visual feedback for AI coding agents (Svelte adapter for Agentation)",
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "build": "vite build && tsup src/runtime.ts --dts-only --format esm --tsconfig tsconfig.json --out-dir dist && node scripts/copy-sources.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@agentation/core": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "agentation-element": "workspace:*",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "postcss-modules": "^6.0.1",
    "preact": "10.29.8",
    "sass": "^1.104.1",
    "svelte": "^5.0.0",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
